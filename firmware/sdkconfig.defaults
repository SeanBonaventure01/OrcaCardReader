CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ESP32-S3-WROOM-1-N4R8: 4 MB quad flash, 8 MB octal PSRAM (verified with esptool 2026-10-13)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# RGB LCD stability: keep the LCD ISR in IRAM and run code/rodata from PSRAM so that
# flash writes don't stall the framebuffer DMA (avoids display drift).
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_COMPILER_CXX_EXCEPTIONS=y
